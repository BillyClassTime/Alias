@page "/admin"
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer

<PageTitle>BillyClassTime Alias Manager</PageTitle>

<div class="d-flex flex-column flex-sm-row
            gap-3 justify-content-between
            align-items-sm-center mb-4">

    <div>

        <h1 class="h3 mb-1">
            Alias
        </h1>

        <p class="text-body-secondary mb-0">
            Administración de redirecciones
        </p>

    </div>

    <button
        type="button"
        class="btn btn-primary">

        Nuevo alias

    </button>

</div>

<div class="card shadow-sm mb-4">

    <div class="card-body">

        <label
            for="search"
            class="form-label">

            Buscar alias

        </label>

        <input
            id="search"
            type="search"
            class="form-control"
            placeholder="Escribe parte del alias..." />

    </div>

</div>

<div class="card shadow-sm">

    <div class="card-body text-center py-5">

        <div
            class="spinner-border text-primary"
            role="status">

            <span class="visually-hidden">
                Cargando...
            </span>

        </div>

        <p class="mt-3 mb-0 text-body-secondary">
            Preparando BillyClassTime Alias Manager...
        </p>

    </div>

</div>