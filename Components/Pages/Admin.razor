@page "/admin"
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer
@using aliasbillyclasstime.Components.Admin

<PageTitle>BillyClassTime Alias Manager</PageTitle>

<div class="d-flex flex-column flex-sm-row
    gap-3 justify-content-between
    align-items-sm-center mb-4">

    <div>
        <h1 class="h3 mb-1">
            Alias
        </h1>

        <p class="text-body-secondary mb-0">
            Administración de redirecciones
        </p>
    </div>

    @if (!IsEditing)
    {
        <button type="button" class="btn btn-primary" @onclick="ShowNewAliasForm">
            Nuevo alias
        </button>
    }

</div>

@if (showNewAliasForm)
{
    <AliasCreate @bind-Alias="newAlias"
                @bind-Url="newUrl"
                ErrorMessage="@createError"
                OnSave="CreateAlias"
                OnCancel="CancelNewAlias" />
}

@if (!IsEditing)
{
    <AliasSearch @bind-SearchText="searchText" />
}

<AliasList Aliases="FilteredAliases"
           EditingAlias="@editingAlias"
           @bind-EditUrl="editUrl"
           AliasToDelete="@aliasToDelete"
           IsOperationActive="@IsEditing"
           EditError="@editError"
           DeleteError="@deleteError"
           OnEdit="HandleEdit"
           OnSaveEdit="SaveEdit"
           OnCancelEdit="CancelEdit"
           OnDelete="ConfirmDelete"
           OnConfirmDelete="DeleteAlias"
           OnCancelDelete="CancelDelete" />