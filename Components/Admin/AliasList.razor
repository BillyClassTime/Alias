@namespace aliasbillyclasstime.Components.Admin

<div class="card shadow-sm">
    <div class="card-body">

        @if (Aliases is null)
        {
            <div class="text-center py-5">

                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">
                        Cargando...
                    </span>
                </div>

                <p class="mt-3 mb-0 text-body-secondary">
                    Cargando alias...
                </p>

            </div>
        }
        else
        {
            <p>
                Alias encontrados: @Aliases.Count()
            </p>

            @foreach (var item in Aliases)
            {
                var isEditingThis = string.Equals(
                    EditingAlias,
                    item.Key,
                    StringComparison.OrdinalIgnoreCase);

                var isDeletingThis = string.Equals(
                    AliasToDelete,
                    item.Key,
                    StringComparison.OrdinalIgnoreCase);

                var hasActiveOperation =
                    !string.IsNullOrWhiteSpace(EditingAlias) ||
                    !string.IsNullOrWhiteSpace(AliasToDelete);

                <div class="border-bottom py-3">

                    <div class="row align-items-center g-3">

                        <div class="col-12 col-md-3">
                            <strong>@item.Key</strong>
                        </div>

                        @if (isEditingThis)
                        {

                            <div class="col-12 col-md-7" style="min-width: 0;">
                                <input type="url"
                                    class="form-control bg-dark text-white w-100"
                                    value="@EditUrl"
                                    @oninput="OnEditUrlInput"
                                    @ref="editUrlInput" />

                                @if (!string.IsNullOrWhiteSpace(EditError))
                                {
                                    <div class="text-danger mt-2">
                                        @EditError
                                    </div>
                                }

                            </div>

                            <div class="col-12 col-md-2">

                                <div class="d-flex gap-2 justify-content-md-end">

                                    <button type="button"
                                            class="btn btn-primary btn-sm"
                                            @onclick="OnSaveEdit">
                                        Guardar
                                    </button>

                                    <button type="button"
                                            class="btn btn-outline-secondary btn-sm"
                                            @onclick="OnCancelEdit">
                                        Cancelar
                                    </button>

                                </div>

                            </div>
                        }
                        else
                        {
                            <div class="col-12 col-md-7" style="min-width: 0;">
                                <div class="bg-dark text-light rounded px-3 py-2 text-break"
                                    style="overflow-wrap: anywhere;">
                                    @item.Value
                                </div>
                            </div>

                            <div class="col-12 col-md-2">

                                @if (!IsOperationActive)
                                {
                                    <div class="d-flex gap-2 flex-wrap justify-content-md-end">    

                                        <button type="button"
                                                class="btn btn-outline-primary btn-sm"
                                                @onclick="() => OnEdit.InvokeAsync(item)">
                                            Editar
                                        </button>

                                        <button type="button"
                                                class="btn btn-outline-danger btn-sm"
                                                @onclick="() => OnDelete.InvokeAsync(item.Key)">
                                            Eliminar
                                        </button>

                                    </div>
                                }

                            </div>
                        }

                    </div>

                    @if (isDeletingThis)
                    {
                        <div class="alert alert-danger mt-3 mb-0">

                            <div class="d-flex flex-column flex-sm-row
                                        justify-content-between
                                        align-items-sm-center gap-3">

                                <div>
                                    <div>
                                        ¿Eliminar el alias
                                        <strong>@item.Key</strong>?
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(DeleteError))
                                    {
                                        <div class="mt-2">
                                            @DeleteError
                                        </div>
                                    }
                                </div>

                                <div class="d-flex gap-2">

                                    <button type="button"
                                            class="btn btn-danger btn-sm"
                                            @onclick="OnConfirmDelete">
                                        Sí, eliminar
                                    </button>

                                    <button type="button"
                                            class="btn btn-secondary btn-sm"
                                            @onclick="OnCancelDelete">
                                        Cancelar
                                    </button>

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }
        }

    </div>
</div>

@code {
    [Parameter]
    public IEnumerable<KeyValuePair<string, string>>? Aliases { get; set; }

    [Parameter]
    public string? EditingAlias { get; set; }

    [Parameter]
    public string EditUrl { get; set; } = "";

    [Parameter]
    public EventCallback<string> EditUrlChanged { get; set; }

    [Parameter]
    public string? AliasToDelete { get; set; }

    [Parameter]
    public string? EditError { get; set; }

    [Parameter]
    public string? DeleteError { get; set; }

    [Parameter]
    public EventCallback<KeyValuePair<string, string>> OnEdit { get; set; }

    [Parameter]
    public EventCallback OnSaveEdit { get; set; }

    [Parameter]
    public EventCallback OnCancelEdit { get; set; }

    [Parameter]
    public EventCallback<string> OnDelete { get; set; }

    [Parameter]
    public EventCallback OnConfirmDelete { get; set; }

    [Parameter]
    public EventCallback OnCancelDelete { get; set; }

    [Parameter]
    public bool IsOperationActive { get; set; }

    private ElementReference editUrlInput;

    private string? lastFocusedEditingAlias;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!string.IsNullOrWhiteSpace(EditingAlias) &&
            EditingAlias != lastFocusedEditingAlias)
        {
            lastFocusedEditingAlias = EditingAlias;
            await editUrlInput.FocusAsync();
        }

        if (string.IsNullOrWhiteSpace(EditingAlias))
        {
            lastFocusedEditingAlias = null;
        }
    }

    private Task OnEditUrlInput(ChangeEventArgs e)
    {
        return EditUrlChanged.InvokeAsync(
            e.Value?.ToString() ?? "");
    }
}